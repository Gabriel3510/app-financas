{
  "name": "sobra",
  "private": true,
  "version": "1.1.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "cap:sync": "npm run build && cap sync",
    "android:apk": "npm run cap:sync && cd android && ./gradlew assembleRelease",
    "desktop": "npm run build && electron .",
    "desktop:linux": "npm run build && electron-builder --linux",
    "desktop:win": "npm run build && electron-builder --win",
    "desktop:mac": "npm run build && electron-builder --mac"
  },
  "devDependencies": {
    "@capacitor/android": "^6.2.3",
    "@capacitor/cli": "^6.2.3",
    "@capacitor/core": "^6.2.3",
    "@capacitor/filesystem": "^6.0.4",
    "@capacitor/ios": "^6.2.3",
    "@capacitor/share": "^6.0.4",
    "@capacitor/status-bar": "^6.0.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "date-fns": "^4.1.0",
    "electron": "^45.2.2",
    "electron-builder": "^26.18.0",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "lucide-react": "^1.14.0",
    "postcss": "^8.5.13",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "recharts": "^3.8.1",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10"
  },
  "main": "electron/main.cjs",
  "description": "Controlo de finanças pessoais",
  "author": {
    "name": "Gabriel Barbosa Lima",
    "email": "78989155+Gabriel3510@users.noreply.github.com"
  },
  "build": {
    "appId": "com.gabriellima.sobra",
    "productName": "Sobra",
    "directories": {
      "output": "release/desktop",
      "buildResources": "electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Finance",
      "icon": "electron/icon.png",
      "maintainer": "Gabriel Barbosa Lima",
      "syncDesktopName": true
    },
    "win": {
      "target": [
        "zip"
      ],
      "icon": "electron/icon.png",
      "signAndEditExecutable": false
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.finance",
      "icon": "electron/icon.png"
    }
  },
  "desktopName": "sobra.desktop"
}
